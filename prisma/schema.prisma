generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  normal
  high
}

enum UserKind {
  guest
  account
}

enum WorkspaceKind {
  personal
  shared
}

enum WorkspaceRole {
  owner
  member
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  displayName      String
  username         String?           @unique
  email            String?           @unique
  passwordHash     String?
  kind             UserKind          @default(guest)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  sessions         Session[]
  workspaceMembers WorkspaceMember[]
  createdProjects  Project[]         @relation("ProjectCreator")
  createdTasks     Task[]            @relation("TaskCreator")

  @@map("users")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  kind      WorkspaceKind     @default(personal)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  members   WorkspaceMember[]
  projects  Project[]
  sessions  Session[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(owner)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("sessions")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  workspaceId String    @db.Uuid
  createdById String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@map("projects")
}

model Task {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  dueDate     DateTime?    @db.Date
  dueAt       DateTime?    @db.Timestamptz(3)
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(normal)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  projectId   Int
  createdById String  @db.Uuid
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("tasks")
}

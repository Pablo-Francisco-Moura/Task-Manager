{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env next dev --turbopack",
    "dev:docker": "node scripts/dev-docker.js",
    "dev:docker:server": "prisma generate && prisma migrate deploy && next dev --hostname 0.0.0.0",
    "dev:docker:clean": "docker compose exec -T app sh -c 'find /app/.next -mindepth 1 -delete' && docker compose restart app",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "npm run migrate:test && dotenv -e .env.test vitest run",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:test": "dotenv -e .env.test -- prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/standard-validator": "^0.2.3",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@prisma/client": "^6.3.1",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "dotenv": "^16.6.1",
    "hono": "^4.7.1",
    "hono-openapi": "^1.1.2",
    "i18next": "^25.8.0",
    "next": "^15.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20.17.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id   Int    @id @default(autoincrement())
  name String

  tasks Task[]

  @@map("projects")
}

model Task {
  id   Int    @id @default(autoincrement())
  name String

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}
